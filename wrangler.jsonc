{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "axuraweb",
  "compatibility_date": "2026-10-26",
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "./public",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "routes": [
    { "pattern": "axura.cloud", "custom_domain": true }
  ]
}
