{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "axura-store",
  "main": "dist/server/index.js",
  "compatibility_date": "2026-10-27",
  "workers_dev": true,
  "kv_namespaces": [{ "binding": "ORDERS" }],
  "routes": [
    { "pattern": "store.axura.cloud", "custom_domain": true }
  ]
}
