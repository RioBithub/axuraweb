{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "axura-store",
  "compatibility_date": "2026-10-27",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "routes": [
    { "pattern": "store.axura.cloud", "custom_domain": true }
  ]
}
